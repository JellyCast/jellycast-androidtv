    <string name="settings_burn_in_ass_off">ASS inbranden: uit</string>
    <string name="settings_burn_in_ass_on">ASS inbranden: aan</string>
    <string name="settings_burn_in_ass_explain">Uit: de tv tekent ASS-ondertitels (vaak bij anime) vereenvoudigd. Aan: volledige opmaak, maar de server zet de video om.</string>
    <string name="settings_change_server">Andere server</string>
    <string name="settings_language">Taal: %1$s</string>
    <string name="settings_language_explain">De taal van menu\'s en knoppen. Titels en beschrijvingen komen van je server, in de taal die daar is ingesteld.</string>
    <string name="settings_movie_view_detail">Filmweergave: detail</string>
    <string name="settings_movie_view_bookcase">Filmweergave: kast</string>
    <string name="settings_movie_view_explain">Detail: één film per scherm, met backdrop. Kast: dvd-ruggen naast elkaar, de gekozen film opengeklapt.</string>
    <string name="settings_max_bitrate_none">Kwaliteit: geen limiet</string>
    <string name="settings_max_bitrate">Kwaliteit: max. %1$d Mbps</string>
    <string name="settings_max_bitrate_explain">Hapert een zware 4K-film over wifi? Boven de limiet zet de server het bestand om naar een lichtere versie.</string>
    <string name="settings_device">Video %1$s (max. %2$s) · HDR %3$s · doorgeven %4$s · PCM %5$d kanalen · uitgang %6$s</string>
    <string name="settings_output_speaker">tv-luidsprekers</string>
    <string name="settings_playback">Geavanceerd afspelen</string>
    <string name="settings_playback_explain">Schermmodus, HDR en doorgeven: corrigeer wat tv en versterker melden als iets niet goed speelt.</string>
    <string name="playback_title">Afspelen</string>
    <string name="playback_frame_rate_always">Beeldfrequentie: altijd</string>
    <string name="playback_frame_rate_system">Beeldfrequentie: systeem</string>
    <string name="playback_frame_rate_off">Beeldfrequentie: uit</string>
    <string name="playback_frame_rate_explain">Altijd: het scherm wisselt naar de beeldfrequentie van de video (24p zonder schokken); het beeld is even zwart. Systeem: volgt “Overeenkomen met framerate” in de instellingen van Google TV.</string>
    <string name="playback_format_auto">%1$s: auto (%2$s)</string>
    <string name="playback_format_on">%1$s: aan</string>
    <string name="playback_format_off">%1$s: uit</string>
    <string name="playback_detected_yes">ja</string>
    <string name="playback_detected_no">nee</string>
    <string name="playback_passthrough_name">Doorgeven %1$s</string>
    <string name="playback_hdr_explain">Auto: wat de tv meldt. Uit: afspelen zonder (Dolby Vision als HDR10) of de server laten omzetten, bijvoorbeeld als de kleuren niet kloppen. Aan: toch afspelen, ook al meldt de tv het niet.</string>
    <string name="playback_passthrough_explain">Doorgeven stuurt het geluid ongewijzigd naar de versterker of soundbar. Auto: wat de uitgang meldt. Uit: dit apparaat decodeert het zelf (geen Atmos). Aan: voor een versterker die meer kan dan hij meldt.</string>
    <string name="playback_downmix_on">Alleen stereo: aan</string>
    <string name="playback_downmix_off">Alleen stereo: uit</string>
    <string name="playback_downmix_explain">Voor een tv of koptelefoon zonder surround: de server levert alles in stereo.</string>
    <string name="playback_lossless_on">TrueHD/DTS zelf decoderen: aan</string>
    <string name="playback_lossless_off">TrueHD/DTS zelf decoderen: uit</string>
    <string name="playback_lossless_explain">Aan: dit apparaat maakt van TrueHD en DTS lossless surround. Hoor je alleen stereo, bijvoorbeeld met een soundbar op gewone ARC? Zet uit: dan een Dolby-spoor of een omzetting.</string>
    <string name="playback_tunneling_auto">Tunneling: auto (Dolby Vision)</string>
    <string name="playback_tunneling_on">Tunneling: aan</string>
    <string name="playback_tunneling_off">Tunneling: uit</string>
    <string name="playback_tunneling_explain">Het apparaat bepaalt zelf wanneer elk beeld getoond wordt. Auto: alleen bij Dolby Vision op een Amlogic-chip, zoals de Chromecast.</string>
    <string name="playback_video_level_check">Videolevel: controleren</string>
    <string name="playback_video_level_ignore">Videolevel: negeren</string>
    <string name="playback_video_level_explain">Sommige apparaten melden een lager videolevel dan ze aankunnen; dan zet de server onnodig om. Negeren: toch direct afspelen.</string>
    <string name="playback_start_delay_none">Startvertraging: geen</string>
    <string name="playback_start_delay">Startvertraging: %1$s s</string>
    <string name="playback_start_delay_explain">Hoor je bij het starten een klik, of valt het geluid even weg (vaak met een versterker ertussen)? Zet dan een vertraging: het geluid begint later, als tv en versterker klaar zijn.</string>
    <string name="settings_device_none">geen</string>

