    <string name="settings_burn_in_ass_off">Incrustar ASS: no</string>
    <string name="settings_burn_in_ass_on">Incrustar ASS: sí</string>
    <string name="settings_burn_in_ass_explain">No: la tele dibuja los subtítulos ASS (habituales en anime) de forma simplificada. Sí: formato completo, pero el servidor convierte el vídeo.</string>
    <string name="settings_change_server">Otro servidor</string>
    <string name="settings_language">Idioma: %1$s</string>
    <string name="settings_language_explain">El idioma de los menús y botones. Los títulos y descripciones vienen de tu servidor, en el idioma configurado allí.</string>
    <string name="settings_movie_view_detail">Películas: detalle</string>
    <string name="settings_movie_view_bookcase">Películas: estantería</string>
    <string name="settings_movie_view_explain">Detalle: una película por pantalla, con imagen de fondo. Estantería: lomos de DVD uno junto a otro, con la película elegida abierta.</string>
    <string name="settings_max_bitrate_none">Calidad: sin límite</string>
    <string name="settings_max_bitrate">Calidad: máx. %1$d Mbps</string>
    <string name="settings_max_bitrate_explain">¿Se entrecorta una película 4K pesada por wifi? Por encima del límite, el servidor convierte el archivo a una versión más ligera.</string>
    <string name="settings_device">Vídeo %1$s (máx. %2$s) · HDR %3$s · passthrough %4$s · PCM %5$d canales · salida %6$s</string>
    <string name="settings_output_speaker">altavoces del televisor</string>
    <string name="settings_playback">Reproducción avanzada</string>
    <string name="settings_playback_explain">Modo de pantalla, HDR y passthrough: corrige lo que indican el televisor y el amplificador si algo no se reproduce bien.</string>
    <string name="playback_title">Reproducción</string>
    <string name="playback_frame_rate_always">Frecuencia: siempre</string>
    <string name="playback_frame_rate_system">Frecuencia: sistema</string>
    <string name="playback_frame_rate_off">Frecuencia: no</string>
    <string name="playback_frame_rate_explain">Siempre: la pantalla cambia a la frecuencia del vídeo (24p sin tirones); la imagen se queda en negro un momento. Sistema: sigue «Coincidir con la velocidad de fotogramas» en los ajustes de Google TV.</string>
    <string name="playback_format_auto">%1$s: auto (%2$s)</string>
    <string name="playback_format_on">%1$s: sí</string>
    <string name="playback_format_off">%1$s: no</string>
    <string name="playback_detected_yes">sí</string>
    <string name="playback_detected_no">no</string>
    <string name="playback_passthrough_name">Passthrough %1$s</string>
    <string name="playback_hdr_explain" tools:ignore="Typos">Auto: lo que indica el televisor. No: reproducir sin ello (Dolby Vision como HDR10) o dejar que el servidor lo convierta, por ejemplo si los colores no son correctos. Sí: reproducirlo aunque el televisor no lo indique.</string>
    <string name="playback_passthrough_explain">El passthrough envía el sonido sin cambios al amplificador o la barra de sonido. Auto: lo que indica la salida. No: este dispositivo lo decodifica (sin Atmos). Sí: para un amplificador que puede más de lo que indica.</string>
    <string name="playback_downmix_on">Solo estéreo: sí</string>
    <string name="playback_downmix_off">Solo estéreo: no</string>
    <string name="playback_downmix_explain">Para un televisor o auriculares sin sonido envolvente: el servidor lo entrega todo en estéreo.</string>
    <string name="playback_lossless_on">TrueHD/DTS en este dispositivo: sí</string>
    <string name="playback_lossless_off">TrueHD/DTS en este dispositivo: no</string>
    <string name="playback_lossless_explain">Sí: este dispositivo decodifica TrueHD y DTS en envolvente sin pérdida. ¿Solo oyes estéreo, por ejemplo con una barra de sonido en ARC normal? Desactívalo: pista Dolby o conversión.</string>
    <string name="playback_tunneling_auto">Tunneling: auto (Dolby Vision)</string>
    <string name="playback_tunneling_on">Tunneling: sí</string>
    <string name="playback_tunneling_off">Tunneling: no</string>
    <string name="playback_tunneling_explain">El dispositivo decide cuándo se muestra cada imagen. Auto: solo con Dolby Vision en un chip Amlogic, como el Chromecast.</string>
    <string name="playback_video_level_check">Nivel de vídeo: comprobar</string>
    <string name="playback_video_level_ignore">Nivel de vídeo: ignorar</string>
    <string name="playback_video_level_explain">Algunos dispositivos indican un nivel de vídeo menor del que admiten y el servidor convierte sin necesidad. Ignorar: reproducir directamente igualmente.</string>
    <string name="playback_start_delay_none">Retraso inicial: no</string>
    <string name="playback_start_delay">Retraso inicial: %1$s s</string>
    <string name="playback_start_delay_explain">¿Oyes un clic al empezar o el sonido se corta un momento (a menudo con un amplificador de por medio)? Añade un retraso: el sonido empieza más tarde, cuando el televisor y el amplificador están listos.</string>
    <string name="settings_device_none">ninguno</string>

