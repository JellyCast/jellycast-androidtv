    <!-- %1$s is the language name in that language itself ("English"); do not translate it. -->
    <string name="settings_language">Language: %1$s</string>
    <string name="settings_language_explain">The language of menus and buttons. Titles and descriptions come from your server, in the language set there.</string>
    <string name="settings_movie_view_detail">Movie view: detail</string>
    <string name="settings_movie_view_bookcase">Movie view: shelf</string>
    <string name="settings_movie_view_explain">Detail: one movie per screen, with backdrop. Shelf: DVD spines side by side, the chosen movie opened up.</string>
    <string name="settings_max_bitrate_none">Quality: no limit</string>
    <string name="settings_max_bitrate">Quality: max. %1$d Mbps</string>
    <string name="settings_max_bitrate_explain">Does a heavy 4K movie stutter over Wi-Fi? Above the limit, the server converts the file to a lighter version.</string>
    <!-- Debug line at the bottom left of Advanced playback. -->
    <string name="settings_device">Video %1$s (max. %2$s) · HDR %3$s · passthrough %4$s · PCM %5$d channels · output %6$s</string>
    <string name="settings_output_speaker">TV speakers</string>
    <string name="settings_playback">Advanced playback</string>
    <string name="settings_playback_explain">Display mode, HDR and passthrough: correct what the TV and amplifier report when something doesn’t play right.</string>
    <string name="playback_title">Playback</string>
    <string name="playback_frame_rate_always">Frame rate: always</string>
    <string name="playback_frame_rate_system">Frame rate: as system</string>
    <string name="playback_frame_rate_off">Frame rate: off</string>
    <string name="playback_frame_rate_explain">Always: the screen switches to the frame rate of the video (24p without judder); the picture goes black for a moment. As system: follows “Match content frame rate” in the Google TV settings.</string>
    <string name="playback_format_auto">%1$s: auto (%2$s)</string>
    <string name="playback_format_on">%1$s: on</string>
    <string name="playback_format_off">%1$s: off</string>
    <string name="playback_detected_yes">yes</string>
    <string name="playback_detected_no">no</string>
    <string name="playback_passthrough_name">Passthrough %1$s</string>
    <string name="playback_hdr_explain">Auto: what the TV reports. Off: play without it (Dolby Vision as HDR10) or let the server convert it, for example when the colours are wrong. On: play it even though the TV doesn’t report it.</string>
    <string name="playback_passthrough_explain">Passthrough sends the sound unchanged to the amplifier or soundbar. Auto: what the output reports. Off: this device decodes it itself (no Atmos). On: for an amplifier that can do more than it reports.</string>
    <string name="playback_downmix_on">Stereo only: on</string>
    <string name="playback_downmix_off">Stereo only: off</string>
    <string name="playback_downmix_explain">For a TV or headphones without surround: the server delivers everything in stereo.</string>
    <string name="playback_lossless_on">TrueHD/DTS on this device: on</string>
    <string name="playback_lossless_off">TrueHD/DTS on this device: off</string>
    <string name="playback_lossless_explain">On: this device decodes TrueHD and DTS to lossless surround. Only hear stereo, for example with a soundbar on plain ARC? Turn off: then a Dolby track or a conversion.</string>
    <string name="playback_tunneling_auto">Tunneling: auto (Dolby Vision)</string>
    <string name="playback_tunneling_on">Tunneling: on</string>
    <string name="playback_tunneling_off">Tunneling: off</string>
    <string name="playback_tunneling_explain">The TV box itself decides when each frame is shown. Auto: only for Dolby Vision on an Amlogic chip, such as the Chromecast.</string>
    <string name="playback_video_level_check">Video level: check</string>
    <string name="playback_video_level_ignore">Video level: ignore</string>
    <string name="playback_video_level_explain">Some boxes report a lower video level than they can play, so the server converts files for nothing. Ignore: play them directly anyway.</string>
    <string name="playback_start_delay_none">Start delay: none</string>
    <string name="playback_start_delay">Start delay: %1$s s</string>
    <string name="playback_start_delay_explain">Do you hear a click at the start, or does the sound drop out briefly (often with an amplifier in between)? Then add a delay: the sound starts later, when the TV and amplifier are ready.</string>
    <string name="settings_device_none">none</string>

