    <string name="settings_burn_in_ass_off">Burn in ASS: off</string>
    <string name="settings_burn_in_ass_on">Burn in ASS: on</string>
    <string name="settings_burn_in_ass_explain">Off: the TV draws ASS subtitles (common with anime) in a simplified way. On: full styling, but the server converts the video.</string>
