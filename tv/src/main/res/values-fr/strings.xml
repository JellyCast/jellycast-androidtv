    <string name="settings_burn_in_ass_off">Incruster ASS : non</string>
    <string name="settings_burn_in_ass_on">Incruster ASS : oui</string>
    <string name="settings_burn_in_ass_explain">Non : la télé affiche les sous-titres ASS (fréquents dans les animés) de façon simplifiée. Oui : mise en forme complète, mais le serveur convertit la vidéo.</string>
    <string name="settings_change_server">Autre serveur</string>
    <string name="settings_language">Langue : %1$s</string>
    <string name="settings_language_explain">La langue des menus et des boutons. Les titres et descriptions viennent de votre serveur, dans la langue qui y est réglée.</string>
    <string name="settings_movie_view_detail">Films : détail</string>
    <string name="settings_movie_view_bookcase">Films : étagère</string>
    <string name="settings_movie_view_explain">Détail : un film par écran, avec image de fond. Étagère : des tranches de DVD côte à côte, le film choisi ouvert.</string>
    <string name="settings_max_bitrate_none">Qualité : sans limite</string>
    <string name="settings_max_bitrate">Qualité : max. %1$d Mbps</string>
    <string name="settings_max_bitrate_explain">Un film 4K lourd saccade en Wi-Fi ? Au-delà de la limite, le serveur convertit le fichier en une version plus légère.</string>
    <string name="settings_device">Vidéo %1$s (max. %2$s) · HDR %3$s · passthrough %4$s · PCM %5$d canaux · sortie %6$s</string>
    <string name="settings_output_speaker">haut-parleurs du téléviseur</string>
    <string name="settings_playback">Lecture avancée</string>
    <string name="settings_playback_explain">Mode d’affichage, HDR et passthrough : corrigez ce que signalent le téléviseur et l’amplificateur si quelque chose ne se lit pas bien.</string>
    <string name="playback_title">Lecture</string>
    <string name="playback_frame_rate_always">Fréquence : toujours</string>
    <string name="playback_frame_rate_system">Fréquence : système</string>
    <string name="playback_frame_rate_off">Fréquence : non</string>
    <string name="playback_frame_rate_explain">Toujours : l’écran passe à la fréquence de la vidéo (24p sans saccades) ; l’image devient noire un instant. Système : suit « Adapter la fréquence d’images » dans les paramètres de Google TV.</string>
    <string name="playback_format_auto">%1$s : auto (%2$s)</string>
    <string name="playback_format_on">%1$s : oui</string>
    <string name="playback_format_off">%1$s : non</string>
    <string name="playback_detected_yes">oui</string>
    <string name="playback_detected_no">non</string>
    <string name="playback_passthrough_name">Passthrough %1$s</string>
    <string name="playback_hdr_explain">Auto : ce que signale le téléviseur. Non : lire sans (Dolby Vision en HDR10) ou laisser le serveur le convertir, par exemple si les couleurs sont fausses. Oui : le lire même si le téléviseur ne le signale pas.</string>
    <string name="playback_passthrough_explain">Le passthrough envoie le son tel quel à l’amplificateur ou à la barre de son. Auto : ce que signale la sortie. Non : cet appareil le décode lui-même (sans Atmos). Oui : pour un amplificateur qui peut plus qu’il ne signale.</string>
    <string name="playback_downmix_on">Stéréo seule : oui</string>
    <string name="playback_downmix_off">Stéréo seule : non</string>
    <string name="playback_downmix_explain">Pour un téléviseur ou un casque sans son surround : le serveur fournit tout en stéréo.</string>
    <string name="playback_lossless_on">TrueHD/DTS décodé ici : oui</string>
    <string name="playback_lossless_off">TrueHD/DTS décodé ici : non</string>
    <string name="playback_lossless_explain">Oui : cet appareil décode TrueHD et DTS en surround sans perte. Seulement de la stéréo, par exemple avec une barre de son en ARC simple ? Désactivez : piste Dolby ou conversion.</string>
    <string name="playback_tunneling_auto">Tunneling : auto (Dolby Vision)</string>
    <string name="playback_tunneling_on">Tunneling : oui</string>
    <string name="playback_tunneling_off">Tunneling : non</string>
    <string name="playback_tunneling_explain">L’appareil décide lui-même quand chaque image s’affiche. Auto : seulement pour Dolby Vision sur une puce Amlogic, comme le Chromecast.</string>
    <string name="playback_video_level_check">Niveau vidéo : vérifier</string>
    <string name="playback_video_level_ignore">Niveau vidéo : ignorer</string>
    <string name="playback_video_level_explain">Certains appareils annoncent un niveau vidéo plus bas qu’ils ne gèrent ; le serveur convertit alors pour rien. Ignorer : lire directement quand même.</string>
    <string name="playback_start_delay_none">Délai au départ : aucun</string>
    <string name="playback_start_delay">Délai au départ : %1$s s</string>
    <string name="playback_start_delay_explain">Un clic au démarrage, ou le son qui se coupe un instant (souvent avec un amplificateur entre les deux) ? Ajoutez un délai : le son démarre plus tard, quand le téléviseur et l’amplificateur sont prêts.</string>
